# Client Configuration (Vite env vars - must prefix with VITE_)

# API Base URL (defaults to /api)
VITE_API_BASE_URL=/api

# WebRTC TURN/STUN Configuration
# STUN servers (comma-separated)
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN servers (comma-separated, format: turn:host:port?transport=udp)
# Requires VITE_TURN_USERNAME and VITE_TURN_PASSWORD to be set
# VITE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# VITE_TURN_USERNAME=your_turn_username
# VITE_TURN_PASSWORD=your_turn_password