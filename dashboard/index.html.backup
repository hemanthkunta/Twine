                <div class="metric-card bg-white p-4 rounded-lg shadow-sm border border-gray-100">
                    <div class="flex items-start">
                        <div class="flex-shrink-0 w-10 h-10 rounded bg-info-100 flex items-center justify-center">
                            <i class="fas fa-robot text-info-600 text-lg"></i>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm text-gray-500">AI Requests (24h)</p>
                            <p id="ai-requests-24h" class="font-medium text-gray-900">--</p>
                        </div>
                    </div>
                </div>
                <div class="metric-card bg-white p-4 rounded-lg shadow-sm border border-gray-100">
                    <div class="flex items-start">
                        <div class="flex-shrink-0 w-10 h-10 rounded bg-primary-100 flex items-center justify-center">
                            <i class="fas fa-shield-alt text-primary-600 text-lg"></i>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm text-gray-500">Security Events (24h)</p>
                            <p id="security-events-24h" class="font-medium text-gray-900">--</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Test Status -->
        <section class="bg-white rounded-xl shadow-md mb-8">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-xl font-semibold text-gray-800 flex items-center">
                    <i class="fas fa-flask text-success-500 mr-2"></i>
                    Test Suite Status
                </h2>
            </div>
            <div class="px-6 py-4" id="test-status-section">
                <div class="text-center py-8 text-gray-500">
        <!-- E2E Encryption Metrics -->
        <section class="bg-white rounded-xl shadow-md mb-8">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-xl font-semibold text-gray-800 flex items-center">
                    <i class="fas fa-lock text-primary-500 mr-2"></i>
                    E2E Encryption Metrics
                </h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 px-6 py-4">
                <div class="metric-card bg-white p-4 rounded-lg shadow-sm border border-gray-100">
                    <div class="flex items-start">
                        <div class="flex-shrink-0 w-10 h-10 rounded bg-success-100 flex items-center justify-center">
                            <i class="fas fa-lock text-success-600 text-lg"></i>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm text-gray-500">Encrypted Messages (24h)</p>
                            <p id="e2e-encrypted-24h" class="font-medium text-gray-900">--</p>
                        </div>
                    </div>
                </div>
                <div class="metric-card bg-white p-4 rounded-lg shadow-sm border border-gray-100">
                    <div class="flex items-start">
                        <div class="flex-shrink-0 w-10 h-10 rounded bg-info-100 flex items-center justify-center">
                <div class="metric-card bg-white p-4 rounded-lg shadow-sm border border-gray-100">
                    <div class="flex items-start">
                        <div class="flex-shrink-0 w-10 h-10 rounded bg-secondary-100 flex items-center justify-center">
                            <i class="fas fa-lock-open text-secondary-600 text-lg"></i>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm text-gray-500">Decrypted Messages (24h)</p>
                            <p id="e2e-decrypted-24h" class="font-medium text-gray-900">--</p>
                        </div>
                    </div>
                </div>
                            <i class="fas fa-exchange-alt text-info-600 text-lg"></i>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm text-gray-500">Key Exchanges (24h)</p>
                            <p id="e2e-key-exchanges-24h" class="font-medium text-gray-900">--</p>
                        </div>
                    </div>
                </div>
                <div class="metric-card bg-white p-4 rounded-lg shadow-sm border border-gray-100">
                    <div class="flex items-start">
                        <div class="flex-shrink-0 w-10 h-10 rounded bg-warning-100 flex items-center justify-center">
                            <i class="fas fa-network-wired text-warning-600 text-lg"></i>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm text-gray-500">Active Sessions</p>
                            <p id="e2e-active-sessions" class="font-medium text-gray-900">--</p>
                        </div>
                    </div>
                </div>
                <div class="metric-card bg-white p-4 rounded-lg shadow-sm border border-gray-100">
                    <div class="flex items-start">
                        <div class="flex-shrink-0 w-10 h-10 rounded bg-error-100 flex items-center justify-center">
                            <i class="fas fa-exclamation-triangle text-error-600 text-lg"></i>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm text-gray-500">Encryption Errors</p>
                            <p id="e2e-encryption-errors" class="font-medium text-gray-900">--</p>
                        </div>
                    </div>
                <div class="metric-card bg-white p-4 rounded-lg shadow-sm border border-gray-100">
                    <div class="flex items-start">
                        <div class="flex-shrink-0 w-10 h-10 rounded bg-error-100 flex items-center justify-center">
                            <i class="fas fa-exclamation-triangle text-error-600 text-lg"></i>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm text-gray-500">Decryption Errors</p>
                            <p id="e2e-decryption-errors" class="font-medium text-gray-900">--</p>
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </section>
                    <i class="fas fa-spinner fa-spin"></i>
                    <p class="mt-2">Loading test results...</p>
                </div>
            </div>
        </section>

        <!-- Recent Activity -->
        <section class="bg-white rounded-xl shadow-md mb-8">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-xl font-semibold text-gray-800 flex items-center">
                    <i class="fas fa-clock text-warning-500 mr-2"></i>
                    Recent Activity
                </h2>
            </div>
            <div class="px-6 py-4" id="recent-activity-section">
                <div class="space-y-3">
                    <div class="text-center py-8 text-gray-500">
                        <i class="fas fa-spinner fa-spin"></i>
                        <p class="mt-2">Loading recent activity...</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Issues & Alerts -->
        <section class="bg-white rounded-xl shadow-md">
            <div class="px-6 py-4 border-b border-gray-200">
                <h2 class="text-xl font-semibold text-gray-800 flex items-center">
                    <i class="fas fa-exclamation-triangle text-error-500 mr-2"></i>
                    Issues & Alerts
                </h2>
            </div>
            <div class="px-6 py-4" id="issues-section">
                <div class="text-center py-8 text-gray-500">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p class="mt-2">Checking for issues...</p>
                </div>
            </div>
        </section>
    </div>

    <script>
        // Dashboard refresh interval (in milliseconds)
        const REFRESH_INTERVAL = 5000;
        const BACKEND_URL = 'http://localhost:4000'; // Adjust if needed

        // Format timestamp
        function formatTimestamp(timestamp) {
            return new Date(timestamp).toLocaleTimeString();
        }

        // Update last updated time
        function updateLastUpdated() {
            document.getElementById('last-updated').textContent = `Last updated: ${new Date().toLocaleTimeString()}`;
        }

        // Fetch project health data
        async function fetchProjectHealth() {
            try {
                // Update last updated time
                updateLastUpdated();

                // Try to fetch from backend health endpoint
                const healthResponse = await fetch(`${BACKEND_URL}/api/health`, { timeout: 3000 });
                const healthData = await healthResponse.json();

                // Update backend status
                const backendStatusEl = document.getElementById('backend-status');
                if (healthData.status === 'ok') {
                    backendStatusEl.textContent = 'Healthy';
                    backendStatusEl.className = 'font-medium text-gray-900 status-healthy';
                } else {
                    backendStatusEl.textContent = 'Unhealthy';
                    backendStatusEl.className = 'font-medium text-gray-900 status-error';
                }

                // Update online users count
                document.getElementById('online-users').textContent = healthData.onlineUsersCount || 0;

                // Try to fetch metrics for more detailed info
                try {
                    const metricsResponse = await fetch(`${BACKEND_URL}/api/metrics`, { timeout: 3000 });
                    const metricsText = await metricsResponse.text();

                    // Parse metrics for key values (simplified parsing)
                    const lines = metricsText.split('\n');
                    let e2eEncrypted24h = 0;
                    let e2eDecrypted24h = 0;
                    let e2eKeyExchanges24h = 0;
                    let e2eActiveSessions = 0;
                    let e2eEncryptionErrors24h = 0;
                    let e2eDecryptionErrors24h = 0;
                    let messages24h = 0;
                    let mediaUploads24h = 0;
                    let aiRequests24h = 0;
                    let securityEvents24h = 0;

                    lines.forEach(line => {
                        if (line.startsWith('e2e_encrypted_messages_total')) {
                            const value = parseFloat(line.split(' ')[1]) || 0;
                            e2eEncrypted24h = value;
                        } else if (line.startsWith('e2e_decrypted_messages_total')) {
                            const value = parseFloat(line.split(' ')[1]) || 0;
                            e2eDecrypted24h = value;
                        } else if (line.startsWith('e2e_key_exchanges_total')) {
                            const value = parseFloat(line.split(' ')[1]) || 0;
                            e2eKeyExchanges24h = value;
                        } else if (line.startsWith('e2e_active_sessions')) {
                            const value = parseFloat(line.split(' ')[1]) || 0;
                            e2eActiveSessions = value;
                        } else if (line.startsWith('e2e_encryption_errors_total')) {
                            const value = parseFloat(line.split(' ')[1]) || 0;
                            e2eEncryptionErrors24h = value;
                        } else if (line.startsWith('e2e_decryption_errors_total')) {
                            const value = parseFloat(line.split(' ')[1]) || 0;
                            e2eDecryptionErrors24h = value;
                        }
                        if (line.startsWith('messages_sent_total')) {
                            const value = parseFloat(line.split(' ')[1]) || 0;
                            messages24h = value; // In a real app, we'd calculate 24h delta
                        } else if (line.startsWith('media_uploads_total')) {
                            const value = parseFloat(line.split(' ')[1]) || 0;
                            mediaUploads24h = value;
                        } else if (line.startsWith('ai_requests_total')) {
                            const value = parseFloat(line.split(' ')[1]) || 0;
                            aiRequests24h = value;
                        } else if (line.startsWith('security_events_total')) {
                            const value = parseFloat(line.split(' ')[1]) || 0;
                            securityEvents24h = value;
                        }
                    });

                    document.getElementById('messages-24h').textContent = messages24h.toLocaleString();
                    document.getElementById('media-uploads-24h').textContent = mediaUploads24h.toLocaleString();
                    document.getElementById('ai-requests-24h').textContent = aiRequests24h.toLocaleString();
document.getElementById('security-events-24h').textContent = securityEvents24h.toLocaleString();                    document.getElementById('e2e-encrypted-24h').textContent = e2eEncrypted24h.toLocaleString();                    document.getElementById('e2e-decrypted-24h').textContent = e2eDecrypted24h.toLocaleString();                    document.getElementById('e2e-key-exchanges-24h').textContent = e2eKeyExchanges24h.toLocaleString();                    document.getElementById('e2e-active-sessions').textContent = e2eActiveSessions.toLocaleString();                    document.getElementById('e2e-encryption-errors').textContent = e2eEncryptionErrors24h.toLocaleString();                    document.getElementById('e2e-decryption-errors').textContent = e2eDecryptionErrors24h.toLocaleString();
                }
                catch (metricsError) {
                    console.warn("Could not fetch metrics:", metricsError);
                    // Set default values
                    document.getElementById("messages-24h").textContent = "--";
                    document.getElementById("media-uploads-24h").textContent = "--";
                    document.getElementById("ai-requests-24h").textContent = "--";
                    document.getElementById("security-events-24h").textContent = "--";
                    document.getElementById("e2e-encrypted-24h").textContent = "--";
                    document.getElementById("e2e-decrypted-24h").textContent = "--";
                    document.getElementById("e2e-key-exchanges-24h").textContent = "--";
                    document.getElementById("e2e-active-sessions").textContent = "--";
                    document.getElementById("e2e-encryption-errors").textContent = "--";
                    document.getElementById("e2e-decryption-errors").textContent = "--";
                }

            } catch (healthError) {
                console.warn('Could not fetch backend health:', healthError);
                // Backend is unreachable
                document.getElementById('backend-status').textContent = 'Unreachable';
                document.getElementById('backend-status').className = 'font-medium text-gray-900 status-error';
                document.getElementById('online-users').textContent = '--';
                document.getElementById('messages-24h').textContent = '--';
                document.getElementById('media-uploads-24h').textContent = '--';
                document.getElementById('ai-requests-24h').textContent = '--';
                document.getElementById("e2e-encrypted-24h").textContent = "--";
                document.getElementById("e2e-decrypted-24h").textContent = "--";
                document.getElementById("e2e-key-exchanges-24h").textContent = "--";
                document.getElementById("e2e-active-sessions").textContent = "--";
                document.getElementById("e2e-encryption-errors").textContent = "--";
                document.getElementById("e2e-decryption-errors").textContent = "--";
                document.getElementById('security-events-24h').textContent = '--';
            }

            // Check frontend status (simplified - in reality we'd check if dev server is running)
            try {
                const frontendResponse = await fetch('http://localhost:3000', { timeout: 2000 });
                const frontendStatusEl = document.getElementById('frontend-status');
                if (frontendResponse.ok) {
                    frontendStatusEl.textContent = 'Running';
                    frontendStatusEl.className = 'font-medium text-gray-900 status-healthy';
                } else {
                    frontendStatusEl.textContent = 'Issues';
                    frontendStatusEl.className = 'font-medium text-gray-900 status-warning';
                }
            } catch (frontendError) {
                const frontendStatusEl = document.getElementById('frontend-status');
                frontendStatusEl.textContent = 'Not Running';
                frontendStatusEl.className = 'font-medium text-gray-900 status-warning';
            }

            // Check database status (from health endpoint if available)
            try {
                const readyResponse = await fetch(`${BACKEND_URL}/api/ready`, { timeout: 3000 });
                const readyData = await readyResponse.json();
                const databaseStatusEl = document.getElementById('database-status');
                if (readyData.database === 'connected') {
                    databaseStatusEl.textContent = 'Connected';
                    databaseStatusEl.className = 'font-medium text-gray-900 status-healthy';
                } else {
                    databaseStatusEl.textContent = 'Disconnected';
                    databaseStatusEl.className = 'font-medium text-gray-900 status-error';
                }
            } catch (dbError) {
                console.warn('Could not check database readiness:', dbError);
                document.getElementById('database-status').textContent = 'Unknown';
                document.getElementById('database-status').className = 'font-medium text-gray-900 status-unknown';
            }
        }

        // Fetch test status (simulated for now)
        async function fetchTestStatus() {
            try {
                const container = document.getElementById('test-status-section');

                // In a real implementation, this would fetch from test runner or CI system
                // For now, we'll simulate based on available test files
                const testSuites = [
                    { name: 'Schema Consistency', file: 'schema_consistency.test.ts', passed: true },
                    { name: 'Security Audit', file: 'security_audit_suite.ts', passed: true },
                    { name: 'Comprehensive Suite', file: 'comprehensive_suite.ts', passed: true },
                    { name: 'Cross-Platform Sync', file: 'cross_platform_sync_suite.ts', passed: true },
                    { name: 'E2E Tests', file: 'e2e_test.ts', passed: true },
                    { name: 'E2E Encryption', file: 'e2e_encryption.test.ts', passed: true }
                ];

                const passedCount = testSuites.filter(t => t.passed).length;
                const totalCount = testSuites.length;
                const passRate = (passedCount / totalCount) * 100;

                container.innerHTML = `
                    <div class="space-y-4">
                        <div class="flex justify-between text-sm text-gray-600 mb-2">
                            <span>Test Suites Passed</span>
                            <span>${passedCount}/${totalCount}</span>
                        </div>
                        <div class="chart-bar mt-1">
                            <div class="chart-bar-fill" style="width: ${passRate}%"></div>
                        </div>
                        <div class="mt-4 space-y-2">
                            ${testSuites.map(test => `
                                <div class="flex items-center py-2 px-3 rounded
                                    ${test.passed ? 'bg-green-50' : 'bg-red-50'} border
                                    ${test.passed ? 'border-green-200' : 'border-red-200'}">
                                    <div class="status-indicator
                                        ${test.passed ? 'status-healthy' : 'status-error'}
                                        flex-shrink-0"></div>
                                    <span class="flex-1 text-sm">${test.name}</span>
                                    ${test.passed ?
                                        '<span class="text-green-600 text-sm">✓ PASSED</span>' :
                                        '<span class="text-red-600 text-sm">✗ FAILED</span>'
                                    }
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
            } catch (error) {
                console.error('Error loading test status:', error);
                document.getElementById('test-status-section').innerHTML =
                    '<p class="text-center py-8 text-gray-500">Error loading test status</p>';
            }
        }

        // Fetch recent activity (git commits and file changes)
        async function fetchRecentActivity() {
            try {
                const container = document.getElementById('recent-activity-section');

                // Get recent git commits
                const commits = await fetchRecentCommits();

                if (commits.length === 0) {
                    container.innerHTML = '<p class="text-center py-4 text-gray-500">No recent commits found</p>';
                    return;
                }

                container.innerHTML = `
                    <div class="space-y-3">
                        ${commits.map(commit => `
                            <div class="flex items-start py-2 border-b border-gray-100 last:border-b-0">
                                <div class="flex-shrink-0 w-10 h-10 rounded bg-info-100 flex items-center justify-center mr-3">
                                    <i class="fas fa-commit text-info-600 text-sm"></i>
                                </div>
                                <div class="flex-1">
                                    <div class="flex justify-between text-sm">
                                        <span class="font-medium text-gray-800">${commit.message.split('\n')[0].substring(0, 50)}${commit.message.length > 50 ? '...' : ''}</span>
                                        <span class="text-xs text-gray-500">${commit.time}</span>
                                    </div>
                                    <div class="flex items-center mt-1">
                                        <span class="px-2 py-0.5 text-xs rounded bg-gray-100 text-gray-800">
                                            ${commit.author}
                                        </span>
                                        ${commit.files > 0 ?
                                            `<span class="ml-2 px-2 py-0.5 text-xs rounded bg-blue-100 text-blue-800">
                                                ${commit.files} files
                                            </span>` : ''
                                        }
                                    </div>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                `;
            } catch (error) {
                console.error('Error loading recent activity:', error);
                document.getElementById('recent-activity-section').innerHTML =
                    '<p class="text-center py-8 text-gray-500">Error loading recent activity</p>';
            }
        }

        // Fetch recent git commits
        async function fetchRecentCommits() {
            try {
                // In a real implementation, we would execute git log or use a git API
                // For simulation, we'll return some example data
                return [
                    {
                        message: "feat: add WebRTC dynamic TURN credentials endpoint",
                        author: "devops",
                        time: "2 min ago",
                        files: 3
                    },
                    {
                        message: "fix: resolve audio stream isolation issues in WebRTC",
                        author: "frontend-dev",
                        time: "15 min ago",
                        files: 5
                    },
                    {
                        message: "chore: update dependencies and lock files",
                        author: "backend-dev",
                        time: "45 min ago",
                        files: 2
                    },
                    {
                        message: "docs: update API documentation for new endpoints",
                        author: "tech-writer",
                        time: "2 hours ago",
                        files: 1
                    }
                ];
            } catch (error) {
                console.error('Error fetching recent commits:', error);
                return [];
            }
        }

        // Fetch issues and alerts
        async function fetchIssues() {
            try {
                const container = document.getElementById('issues-section');

                // In a real implementation, this would check:
                // - Failed tests
                // - Error logs
                // - Performance thresholds
                // - Security alerts
                // - Dependency vulnerabilities

                // For simulation, we'll check if there are any obvious issues
                const issues = [];

                // Check if there are any uncommitted changes that might be problematic
                // This would require git status check in a real implementation

                if (issues.length === 0) {
                    container.innerHTML = `
                        <div class="flex items-center">
                            <div class="flex-shrink-0">
                                <i class="fas fa-check-circle text-success-500"></i>
                            </div>
                            <div class="ml-3">
                                <p class="text-sm text-success-800">No issues detected</p>
                            </div>
                        </div>
                    `;
                    return;
                }

                container.innerHTML = `
                    <div class="space-y-3">
                        ${issues.map(issue => `
                            <div class="flex items-start py-2 px-3 rounded
                                ${issue.severity === 'critical' ? 'bg-red-50' :
                                 issue.severity === 'warning' ? 'bg-yellow-50' :
                                 'bg-blue-50'} border
                                ${issue.severity === 'critical' ? 'border-red-200' :
                                 issue.severity === 'warning' ? 'border-yellow-200' :
                                 'border-blue-200'}">
                                <div class="status-indicator
                                    ${issue.severity === 'critical' ? 'status-error' :
                                     issue.severity === 'warning' ? 'status-warning' :
                                     'status-info'}
                                    flex-shrink-0"></div>
                                <div class="flex-1">
                                    <p class="text-sm font-medium">${issue.title}</p>
                                    <p class="text-xs text-gray-500">${issue.description}</p>
                                </div>
                                ${issue.action ?
                                    `<button onclick="alert('${issue.action}')"
                                        class="ml-2 px-2 py-0.5 text-xs rounded bg-${issue.severity === 'critical' ? 'red' : issue.severity === 'warning' ? 'yellow' : 'blue'}-100 text-${issue.severity === 'critical' ? 'red' : issue.severity === 'warning' ? 'yellow' : 'blue'}-800">
                                        ${issue.actionLabel || 'Action'}
                                    </button>` : ''
                                }
                            </div>
                        `).join('')}
                    </div>
                `;
            } catch (error) {
                console.error('Error loading issues:', error);
                document.getElementById('issues-section').innerHTML =
                    '<p class="text-center py-8 text-gray-500">Error loading issues</p>';
            }
        }

        // Initialize dashboard
        function initDashboard() {
            fetchProjectHealth();
            fetchTestStatus();
            fetchRecentActivity();
            fetchIssues();

            // Set up periodic updates
            setInterval(() => {
                fetchProjectHealth();
                fetchTestStatus();
                fetchRecentActivity();
                fetchIssues();
            }, REFRESH_INTERVAL);
        }

        // Start dashboard when page loads
        document.addEventListener('DOMContentLoaded', initDashboard);
    </script>
</body>
</html>