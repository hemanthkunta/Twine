# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Secret (minimum 32 characters in production)
JWT_SECRET=development-only-ephemeral-secret-change-me

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000

# SQLite Database File Path
DB_PATH=./messaging.db

# WebRTC TURN/STUN Configuration (Client-side via Vite)
# VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# VITE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# VITE_TURN_USERNAME=your_turn_username
# VITE_TURN_PASSWORD=your_turn_password
