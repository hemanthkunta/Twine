# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Secret (minimum 32 characters in production)
JWT_SECRET=development-only-ephemeral-secret-change-me

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000

# SQLite Database File Path
DB_PATH=./messaging.db

# Redis (optional in development; required by the production Compose stack)
REDIS_HOST=localhost
REDIS_PORT=6379

# Browser Web Push: generate once with backend's web-push.generateVAPIDKeys().
# Keep the private key on the server. Use HTTPS in deployment.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# SMS delivery: twilio, vonage, or webhook. 'test' is non-production only.
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# VONAGE_FROM_NUMBER=
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_HMAC_SECRET=

# WebRTC TURN/STUN Configuration (Client-side via Vite)
# VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# VITE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# VITE_TURN_USERNAME=your_turn_username
# VITE_TURN_PASSWORD=your_turn_password
