{
  "name": "messaging-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Telegram-style real-time messaging platform backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run test:schema && npm run test:security && npm run test:comprehensive",
    "test:schema": "tsx src/test/schema_consistency.test.ts",
    "test:security": "tsx src/test/security_audit_suite.ts",
    "test:comprehensive": "tsx src/test/comprehensive_suite.ts",
    "test:sync": "tsx src/test/cross_platform_sync_suite.ts",
    "test:e2e": "tsx src/test/e2e_test.ts",
    "test:otp": "tsx src/test/otp_flow.test.ts",
    "test:phase1": "tsx src/test/phase1_mvp_suite.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "libsignal-protocol-typescript": "^0.0.18",
    "pino": "^10.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.10",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
