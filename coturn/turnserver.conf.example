# ====================================================================
# Coturn TURN Server Production Configuration
# Twine Secure WebRTC Calling Infrastructure
# ====================================================================

# STUN / TURN standard ports
listening-port=3478
tls-listening-port=5349

# Listening interfaces (0.0.0.0 listens on all IPv4 addresses)
listening-ip=0.0.0.0

# Protocol features
fingerprint
lt-cred-mech
use-auth-secret

# ⚠️ STATIC AUTH SECRET (Must match TURN_SHARED_SECRET on Twine backend)
# Replace with a strong 32+ character random string
static-auth-secret=REPLACE_WITH_YOUR_STRONG_RANDOM_SECRET

# Domain / Realm (Must match your domain / cert)
realm=turn.yourdomain.com

# TLS Certificates (Generated via Let's Encrypt / Certbot)
cert=/etc/letsencrypt/live/turn.yourdomain.com/fullchain.pem
pkey=/etc/letsencrypt/live/turn.yourdomain.com/privkey.pem

# TURN Media Relay UDP Port Range (Crucial for peer-to-peer audio/video relay)
min-port=49152
max-port=65535

# Logging & Performance
log-file=/var/log/turnserver.log
verbose
no-cli
no-loopback-peers
no-multicast-peers
